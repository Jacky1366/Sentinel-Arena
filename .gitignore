# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
# the dashboard's static offline bundle is committed (Stage 6.4: laptop demo, no build needed)
!dashboard/dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Environments / secrets ---
.env
.env.*
!.env.example
.venv/
venv/

# --- Node (dashboard) ---
node_modules/

# --- OS ---
.DS_Store

# --- Match output (keep the directory, ignore its contents) ---
data/runs/*
!data/runs/.gitkeep

# --- Designer label audits (D16): dev audits stay local; golden audits are committed ---
data/audits/*
!data/audits/.gitkeep

# --- Blue replays (D17): output of tools/replay_blue.py, never committed by default ---
data/replays/*
!data/replays/.gitkeep

# --- Rule library (Stage 6.1): every library version and its retention evidence is
# committed (raw evidence is never deleted; designer, 2026-11-18), so nothing under
# data/library/ is ignored ---
