{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-arena.local/schemas/red_attack.schema.json",
  "title": "Red attack record (contract v0.1)",
  "description": "One line of data/runs/<match_id>/red_attacks.jsonl. Ground truth. Blue must NEVER read this.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "match_id", "round", "request_id", "label", "payload", "endpoint", "method", "timestamp"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "match_id": { "type": "string", "pattern": "^m[0-9]{3,}$" },
    "round": { "type": "integer", "minimum": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "label": { "enum": ["CWE-89", "CWE-79", "CWE-22"] },
    "payload": { "type": "string" },
    "endpoint": { "type": "string", "pattern": "^/" },
    "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
