{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-arena.local/schemas/compare_bundle.schema.json",
  "title": "Compare bundle (Stage 7 #15; D52; contract 6.18)",
  "description": "N Blue arms over the same frozen traffic, joined by request_id (tools/export_compare.py). Copy only: every value comes from an artifact (Red record, round records, benign results, the free-play binary audit, the challenge catalog). Humans and the dashboard read it; Blue never does.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "kind", "title", "arms", "matches", "rows", "aggregate", "fp_check", "notes"],
  "$defs": {
    "rate": {"type": ["object", "null"], "additionalProperties": false, "required": ["num", "den"],
             "properties": {"num": {"type": "integer", "minimum": 0}, "den": {"type": "integer", "minimum": 0}}},
    "verdict": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["verdict", "detected", "source", "reason"],
      "properties": {
        "verdict": {"type": ["string", "null"]},
        "detected": {"type": ["boolean", "null"]},
        "source": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "0.1"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"},
    "kind": {"const": "compare"},
    "title": {"type": "string"},
    "arms": {
      "type": "array", "minItems": 2,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "blue"],
                "properties": {"id": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"},
                               "label": {"type": "string"}, "blue": {"enum": ["original", "open"]}}}
    },
    "matches": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["match", "match_id", "audit", "per_arm", "folders", "red_model"],
        "properties": {
          "match": {"type": "integer", "minimum": 1},
          "match_id": {"type": "string"},
          "audit": {"type": ["string", "null"]},
          "red_model": {"type": ["string", "null"]},
          "folders": {"type": "object", "additionalProperties": {"type": "string"}},
          "per_arm": {"type": "object", "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["detection", "audited"],
            "properties": {"detection": {"$ref": "#/$defs/rate"}, "audited": {"type": "boolean"}}}}
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["match", "match_id", "round", "request_id", "label", "technique", "method", "path",
                     "payload", "headers_set", "attack_attempt", "landed", "solved", "verdicts", "divergent"],
        "properties": {
          "match": {"type": "integer", "minimum": 1},
          "match_id": {"type": "string"},
          "round": {"type": "integer", "minimum": 1},
          "request_id": {"type": "string"},
          "label": {"type": ["string", "null"]},
          "technique": {"type": ["string", "null"]},
          "method": {"type": ["string", "null"]},
          "path": {"type": ["string", "null"]},
          "payload": {"type": ["string", "null"]},
          "headers_set": {"type": "array", "items": {"type": "string"}},
          "attack_attempt": {"enum": ["yes", "no", "unaudited"]},
          "landed": {"type": "boolean"},
          "solved": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                     "required": ["challenge", "category"],
                     "properties": {"challenge": {"type": "string"}, "category": {"type": "string"}}}},
          "verdicts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/verdict"}},
          "divergent": {"type": "boolean"}
        }
      }
    },
    "aggregate": {"type": "object", "additionalProperties": {
      "type": "object", "additionalProperties": false,
      "required": ["detected", "attempts", "landed_detected", "landed_attempts"],
      "properties": {"detected": {"type": "integer", "minimum": 0}, "attempts": {"type": "integer", "minimum": 0},
                     "landed_detected": {"type": "integer", "minimum": 0},
                     "landed_attempts": {"type": "integer", "minimum": 0}}}},
    "fp_check": {"type": ["object", "null"], "additionalProperties": {
      "type": "object", "additionalProperties": false, "required": ["fp", "n", "folder"],
      "properties": {"fp": {"type": "integer", "minimum": 0}, "n": {"type": "integer", "minimum": 1},
                     "folder": {"type": "string"}}}},
    "notes": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
