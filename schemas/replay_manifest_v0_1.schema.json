{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-arena.local/schemas/replay_manifest_v0_1.schema.json",
  "title": "Replay manifest (contract 6.9, schema_version 0.1), schema_version 0.1 (FROZEN)",
  "description": "data/replays/<replay_id>/replay.json (Stage 5.5, D17), written LAST by tools/replay_blue.py. A replay runs Blue and the full Judge on a COPY of a frozen match's inputs (proxy log, Red records, benign records, snapshots, Red unsent slots); it never writes into the source folder. source records the source match id, its match.json sha256 and every source artifact hash (from its match.json), and which files were copied (each verified against those hashes first). Verdicts and rounds keep the source match_id, so the source's D16 audit applies; a replay is identified by replay_id. status/failed_step/error/budget/cost follow match.json (contract 6.2); cost covers this replay's Blue calls only (Red's calls are never copied).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "replay_id",
    "started_at",
    "finished_at",
    "status",
    "failed_step",
    "error",
    "judge_version",
    "source",
    "blue_engine",
    "blue_params",
    "git",
    "models",
    "budget",
    "price_table",
    "cost",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "replay_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "stopped"
      ]
    },
    "failed_step": {
      "enum": [
        null,
        "judge_fact1",
        "blue",
        "judge_rounds",
        "judge_benign",
        "judge_red",
        "judge_rules"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "judge_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "path",
        "match_json_sha256",
        "status",
        "judge_version",
        "blue_engine",
        "red_engine",
        "artifacts",
        "copied"
      ],
      "properties": {
        "match_id": {
          "type": "string",
          "pattern": "^(m[0-9]{3,}|[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4})$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "match_json_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "completed",
            "stopped"
          ]
        },
        "judge_version": {
          "type": "string"
        },
        "blue_engine": {
          "enum": [
            "scripted",
            "claude"
          ]
        },
        "red_engine": {
          "enum": [
            "scripted",
            "ai"
          ]
        },
        "artifacts": {
          "type": "object",
          "propertyNames": {
            "not": {
              "const": "match.json"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "bytes"
            ],
            "properties": {
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "copied": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "blue_engine": {
      "enum": [
        "scripted",
        "claude"
      ]
    },
    "blue_params": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "chunk_size",
            "prompt_version",
            "system_prompt_sha256",
            "sdk",
            "request",
            "rules"
          ],
          "properties": {
            "provider": {
              "enum": [
                "openai",
                "anthropic",
                "gemini",
                "fake"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "chunk_size": {
              "type": "integer",
              "minimum": 1
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "system_prompt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "sdk": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "package",
                    "version"
                  ],
                  "properties": {
                    "package": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_output_tokens",
                "thinking",
                "effort",
                "output_format",
                "temperature",
                "temperature_note"
              ],
              "properties": {
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "thinking": {
                  "enum": [
                    null,
                    "disabled",
                    "adaptive"
                  ]
                },
                "effort": {
                  "enum": [
                    null,
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "output_format": {
                  "enum": [
                    "json_schema",
                    "none"
                  ]
                },
                "temperature": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "temperature_note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "rules": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "max_rules"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "off",
                    "shadow",
                    "on"
                  ]
                },
                "max_rules": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blue"
      ],
      "properties": {
        "blue": {
          "$ref": "#/$defs/model_ref"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limits",
        "stopped_by"
      ],
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "red",
            "blue",
            "analyst",
            "match"
          ],
          "properties": {
            "red": {
              "$ref": "#/$defs/agent_limit"
            },
            "blue": {
              "$ref": "#/$defs/agent_limit"
            },
            "analyst": {
              "$ref": "#/$defs/agent_limit"
            },
            "match": {
              "$ref": "#/$defs/limit"
            }
          }
        },
        "stopped_by": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "reason"
              ],
              "properties": {
                "scope": {
                  "enum": [
                    "red",
                    "blue",
                    "analyst",
                    "match"
                  ]
                },
                "reason": {
                  "enum": [
                    "max_calls",
                    "max_tokens",
                    "max_usd",
                    "unpriced_usage",
                    "missing_price",
                    "price_unverified",
                    "missing_key"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "price_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "as_of"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_usd",
        "failed_attempts_usd",
        "cache_savings_usd",
        "attempts",
        "failed_attempts",
        "refused",
        "tokens",
        "by_agent",
        "by_model",
        "lower_bound",
        "cached_at_input_price",
        "unpriced_usage",
        "prices_verified"
      ],
      "properties": {
        "total_usd": {
          "$ref": "#/$defs/usd"
        },
        "failed_attempts_usd": {
          "$ref": "#/$defs/usd"
        },
        "cache_savings_usd": {
          "type": "number"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "by_agent": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "red",
              "blue",
              "analyst"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/bucket"
          }
        },
        "by_model": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/bucket"
          }
        },
        "lower_bound": {
          "type": "boolean"
        },
        "cached_at_input_price": {
          "type": "boolean"
        },
        "unpriced_usage": {
          "type": "boolean"
        },
        "prices_verified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "not": {
          "const": "match.json"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes"
        ],
        "properties": {
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "image_id",
        "repo_digest"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repo_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "model_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model"
          ],
          "properties": {
            "provider": {
              "enum": [
                "openai",
                "anthropic",
                "gemini",
                "fake"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_calls",
        "max_tokens",
        "max_usd"
      ],
      "properties": {
        "max_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "agent_limit": {
      "allOf": [
        {
          "$ref": "#/$defs/limit"
        },
        {
          "properties": {
            "max_calls": {
              "type": "integer"
            },
            "max_tokens": {
              "type": "integer"
            },
            "max_usd": {
              "type": "number"
            }
          }
        }
      ]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "cached_input",
        "cache_write",
        "output"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "usd": {
      "type": "number",
      "minimum": 0
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usd",
        "failed_attempts_usd",
        "attempts",
        "failed_attempts",
        "refused",
        "tokens"
      ],
      "properties": {
        "usd": {
          "$ref": "#/$defs/usd"
        },
        "failed_attempts_usd": {
          "$ref": "#/$defs/usd"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "failed_step": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "failed_step": {
            "const": null
          },
          "error": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "budget": {
            "properties": {
              "stopped_by": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "stopped"
          }
        }
      },
      "then": {
        "properties": {
          "budget": {
            "properties": {
              "stopped_by": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "blue_engine": {
            "const": "scripted"
          }
        }
      },
      "then": {
        "properties": {
          "blue_params": {
            "type": "null"
          },
          "models": {
            "properties": {
              "blue": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "blue_params": {
            "type": "object"
          },
          "models": {
            "properties": {
              "blue": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  ]
}
