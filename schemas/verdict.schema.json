{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-arena.local/schemas/verdict.schema.json",
  "title": "Blue verdict (contract v0.1)",
  "description": "One line of data/runs/<match_id>/verdicts.jsonl. 'reason' is for humans only; the Judge never reads it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "match_id", "round", "request_id", "verdict", "reason"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "match_id": { "type": "string", "pattern": "^m[0-9]{3,}$" },
    "round": { "type": "integer", "minimum": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "verdict": { "enum": ["CWE-89", "CWE-79", "CWE-22", "benign"] },
    "reason": { "type": "string" }
  }
}
