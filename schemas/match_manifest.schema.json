{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-arena.local/schemas/match_manifest.schema.json",
  "title": "Match manifest (schema_version 0.6; contract 6.2)",
  "description": "data/runs/<match_id>/match.json, schema_version 0.6 (Stage 5.5 on): one JSON object written by the orchestrator (run_match.py) as the LAST file of every match, completed, failed or stopped (contract 6.2). failed_step and error are null iff status is not failed. stopped means a budget refusal or unpriced usage ended an agent's calls early; budget.stopped_by says which. artifacts lists every other file with its sha256 and size. traffic records the seed, the benign set and the planned schedule. blue_params records the AI Blue configuration (null for scripted Blue); models.blue is non-null iff blue_engine is claude. red_engine says who chose the attacks; red_source (the payload file) is non-null iff scripted, red_params and models.red iff ai. Older manifests are validated by match_manifest_v0_1 / v0_2 / v0_3 / v0_4.schema.json. 0.6 (Stage 5.5): blue_params gains the required rules block {mode: off|shadow|on, max_rules} (rule invention, D9), and failed_step gains judge_rules (Judge facts 3 + 4b inside the match). 0.5 manifests are validated by match_manifest_v0_5.schema.json. Schema 0.7 (Stage 5.7): blue_params and red_params carry caching {mode, ttl}; every cost bucket carries cache_savings_usd (net, may be negative). red_params.request.prompt_caching (free text) is removed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "match_id",
    "started_at",
    "finished_at",
    "status",
    "failed_step",
    "error",
    "judge_version",
    "blue_engine",
    "red_source",
    "git",
    "images",
    "artifacts",
    "models",
    "budget",
    "price_table",
    "cost",
    "traffic",
    "blue_params",
    "red_engine",
    "red_params"
  ],
  "$defs": {
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "image_id",
        "repo_digest"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repo_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "model_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model"
          ],
          "properties": {
            "provider": {
              "enum": [
                "openai",
                "anthropic",
                "gemini",
                "fake"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_calls",
        "max_tokens",
        "max_usd"
      ],
      "properties": {
        "max_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "agent_limit": {
      "allOf": [
        {
          "$ref": "#/$defs/limit"
        },
        {
          "properties": {
            "max_calls": {
              "type": "integer"
            },
            "max_tokens": {
              "type": "integer"
            },
            "max_usd": {
              "type": "number"
            }
          }
        }
      ]
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "cached_input",
        "cache_write",
        "output"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "usd": {
      "type": "number",
      "minimum": 0
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usd",
        "failed_attempts_usd",
        "attempts",
        "failed_attempts",
        "refused",
        "tokens",
        "cache_savings_usd"
      ],
      "properties": {
        "usd": {
          "$ref": "#/$defs/usd"
        },
        "failed_attempts_usd": {
          "$ref": "#/$defs/usd"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "cache_savings_usd": {
          "type": "number",
          "description": "net cache savings of this bucket's calls (may be negative: writes cost more than input)"
        }
      }
    },
    "caching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ttl"
      ],
      "description": "Prompt caching (Stage 5.7, D18): a cost setting, held constant within any comparison. ttl is the cache-write lifetime used (Anthropic 5m, OpenAI 30m); null iff mode is off.",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "on"
          ]
        },
        "ttl": {
          "enum": [
            null,
            "5m",
            "30m"
          ]
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "off"
          }
        }
      },
      "then": {
        "properties": {
          "ttl": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "ttl": {
            "enum": [
              "5m",
              "30m"
            ]
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.7"
    },
    "match_id": {
      "type": "string",
      "pattern": "^(m[0-9]{3,}|[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4})$"
    },
    "started_at": {
      "$ref": "#/$defs/utc"
    },
    "finished_at": {
      "$ref": "#/$defs/utc"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "stopped"
      ]
    },
    "failed_step": {
      "enum": [
        null,
        "reset",
        "rotate",
        "traffic",
        "freeze",
        "judge_fact1",
        "blue",
        "judge_rounds",
        "judge_benign",
        "judge_red",
        "judge_rules"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "judge_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "blue_engine": {
      "enum": [
        "scripted",
        "claude"
      ]
    },
    "red_source": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "juice_shop",
        "nginx"
      ],
      "properties": {
        "juice_shop": {
          "$ref": "#/$defs/image"
        },
        "nginx": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "not": {
          "const": "match.json"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes"
        ],
        "properties": {
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "red",
        "blue",
        "analyst"
      ],
      "properties": {
        "red": {
          "$ref": "#/$defs/model_ref"
        },
        "blue": {
          "$ref": "#/$defs/model_ref"
        },
        "analyst": {
          "$ref": "#/$defs/model_ref"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limits",
        "stopped_by"
      ],
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "red",
            "blue",
            "analyst",
            "match"
          ],
          "properties": {
            "red": {
              "$ref": "#/$defs/agent_limit"
            },
            "blue": {
              "$ref": "#/$defs/agent_limit"
            },
            "analyst": {
              "$ref": "#/$defs/agent_limit"
            },
            "match": {
              "$ref": "#/$defs/limit"
            }
          }
        },
        "stopped_by": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "reason"
              ],
              "properties": {
                "scope": {
                  "enum": [
                    "red",
                    "blue",
                    "analyst",
                    "match"
                  ]
                },
                "reason": {
                  "enum": [
                    "max_calls",
                    "max_tokens",
                    "max_usd",
                    "unpriced_usage",
                    "missing_price",
                    "price_unverified",
                    "missing_key"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "price_table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "as_of"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_usd",
        "failed_attempts_usd",
        "cache_savings_usd",
        "attempts",
        "failed_attempts",
        "refused",
        "tokens",
        "by_agent",
        "by_model",
        "lower_bound",
        "cached_at_input_price",
        "unpriced_usage",
        "prices_verified"
      ],
      "properties": {
        "total_usd": {
          "$ref": "#/$defs/usd"
        },
        "failed_attempts_usd": {
          "$ref": "#/$defs/usd"
        },
        "cache_savings_usd": {
          "type": "number"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        },
        "by_agent": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "red",
              "blue",
              "analyst"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/bucket"
          }
        },
        "by_model": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/bucket"
          }
        },
        "lower_bound": {
          "type": "boolean"
        },
        "cached_at_input_price": {
          "type": "boolean"
        },
        "unpriced_usage": {
          "type": "boolean"
        },
        "prices_verified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "seed_source",
        "benign_set",
        "schedule"
      ],
      "description": "How Red and benign traffic were interleaved. schedule is the PLANNED order from the seed (red:<round> | benign:<benign_id>); both sequences keep their own order. Blue never reads match.json.",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "seed_source": {
          "enum": [
            "cli",
            "generated"
          ]
        },
        "benign_set": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "set_version"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "set_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(red:[1-9][0-9]*|benign:[nh][0-9]{2})$"
          }
        }
      }
    },
    "blue_params": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "chunk_size",
            "prompt_version",
            "system_prompt_sha256",
            "sdk",
            "request",
            "rules",
            "caching"
          ],
          "properties": {
            "provider": {
              "enum": [
                "openai",
                "anthropic",
                "gemini",
                "fake"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "chunk_size": {
              "type": "integer",
              "minimum": 1
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "system_prompt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "sdk": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "package",
                    "version"
                  ],
                  "properties": {
                    "package": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_output_tokens",
                "thinking",
                "effort",
                "output_format",
                "temperature",
                "temperature_note"
              ],
              "properties": {
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "thinking": {
                  "enum": [
                    null,
                    "disabled",
                    "adaptive"
                  ]
                },
                "effort": {
                  "enum": [
                    null,
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "output_format": {
                  "enum": [
                    "json_schema",
                    "none"
                  ]
                },
                "temperature": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "temperature_note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "rules": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "max_rules"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "off",
                    "shadow",
                    "on"
                  ]
                },
                "max_rules": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "caching": {
              "$ref": "#/$defs/caching"
            }
          }
        }
      ]
    },
    "red_engine": {
      "enum": [
        "scripted",
        "ai"
      ]
    },
    "red_params": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model",
            "round_cap",
            "prompt_version",
            "system_prompt_sha256",
            "sdk",
            "request",
            "feedback_body_chars",
            "guard",
            "caching"
          ],
          "properties": {
            "provider": {
              "enum": [
                "openai",
                "anthropic",
                "gemini",
                "fake"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "round_cap": {
              "type": "integer",
              "minimum": 1
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "system_prompt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "sdk": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "package",
                    "version"
                  ],
                  "properties": {
                    "package": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_output_tokens",
                "reasoning_effort",
                "output_format",
                "store",
                "temperature",
                "temperature_note"
              ],
              "properties": {
                "max_output_tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "reasoning_effort": {
                  "enum": [
                    null,
                    "none",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "output_format": {
                  "enum": [
                    "json_schema",
                    "none"
                  ]
                },
                "store": {
                  "type": "boolean"
                },
                "temperature": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "temperature_note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "feedback_body_chars": {
              "type": "integer",
              "minimum": 0
            },
            "guard": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "methods",
                "max_path_chars",
                "max_body_chars"
              ],
              "properties": {
                "methods": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "max_path_chars": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_body_chars": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "caching": {
              "$ref": "#/$defs/caching"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "failed_step": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "failed_step": {
            "const": null
          },
          "error": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "budget": {
            "properties": {
              "stopped_by": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "stopped"
          }
        }
      },
      "then": {
        "properties": {
          "budget": {
            "properties": {
              "stopped_by": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "comment": "scripted Blue has no model and no blue_params; claude Blue has both",
      "if": {
        "properties": {
          "blue_engine": {
            "const": "scripted"
          }
        }
      },
      "then": {
        "properties": {
          "blue_params": {
            "type": "null"
          },
          "models": {
            "properties": {
              "blue": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "blue_params": {
            "type": "object"
          },
          "models": {
            "properties": {
              "blue": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "comment": "scripted Red: payload file, no model; AI Red: model + red_params, no payload file",
      "if": {
        "properties": {
          "red_engine": {
            "const": "scripted"
          }
        }
      },
      "then": {
        "properties": {
          "red_source": {
            "type": "object"
          },
          "red_params": {
            "type": "null"
          },
          "models": {
            "properties": {
              "red": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "red_source": {
