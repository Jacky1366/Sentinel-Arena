{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-arena.local/schemas/api_call.schema.json",
  "title": "API call attempt (contract 6.3)",
  "description": "One line of data/runs/<match_id>/api_calls.jsonl, written by agents/llm_client.py for every attempt (including failures and retries) and for every call the body refused before sending (refusal non-null, nothing sent). input_tokens is full-price input only; the whole prompt is input_tokens + cached_input_tokens + cache_write_tokens. A null token count means the provider reported no usage. Never contains a key, prompt text or error text. stop_reason is the provider's stop reason for a reply (e.g. end_turn, max_tokens, refusal; a safety refusal is an ok reply with stop_reason refusal); null when there was no reply. provider comes from config/llm.json (never from the price table), so it is never null, even for a missing_price refusal. Schema 0.2 (Stage 5.7): unpriced_cache_write_tokens is the part of cache_write_tokens written at a cache lifetime config/prices.json has no price for (Anthropic 1-hour, OpenAI 12-hour, or an unknown write breakdown; cache_write prices are the Anthropic 5-minute and OpenAI 30-minute writes). Any value > 0 stops the match (unpriced_usage). 0.1 lines (frozen schema) have no such field and are read as 0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "match_id",
    "timestamp",
    "agent",
    "provider",
    "model",
    "round",
    "log_seq_first",
    "log_seq_last",
    "attempt",
    "ok",
    "error_type",
    "http_status",
    "refusal",
    "stop_reason",
    "input_tokens",
    "cached_input_tokens",
    "cache_write_tokens",
    "unpriced_cache_write_tokens",
    "output_tokens",
    "latency_ms",
    "prompt_sha256"
  ],
  "$defs": {
    "tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "seq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "match_id": {
      "type": "string",
      "pattern": "^(m[0-9]{3,}|[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4})$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "agent": {
      "enum": [
        "red",
        "blue",
        "analyst"
      ]
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "gemini",
        "fake"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "round": {
      "$ref": "#/$defs/seq"
    },
    "log_seq_first": {
      "$ref": "#/$defs/seq"
    },
    "log_seq_last": {
      "$ref": "#/$defs/seq"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "ok": {
      "type": "boolean"
    },
    "error_type": {
      "enum": [
        null,
        "timeout",
        "rate_limit",
        "server_error",
        "connection",
        "auth",
        "bad_request",
        "other",
        "refused"
      ]
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "refusal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "reason"
          ],
          "properties": {
            "scope": {
              "enum": [
                "red",
                "blue",
                "analyst",
                "match"
              ]
            },
            "reason": {
              "enum": [
                "max_calls",
                "max_tokens",
                "max_usd",
                "unpriced_usage",
                "missing_price",
                "price_unverified",
                "missing_key"
              ]
            }
          }
        }
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "input_tokens": {
      "$ref": "#/$defs/tokens"
    },
    "cached_input_tokens": {
      "$ref": "#/$defs/tokens"
    },
    "cache_write_tokens": {
      "$ref": "#/$defs/tokens"
    },
    "unpriced_cache_write_tokens": {
      "$ref": "#/$defs/tokens"
    },
    "output_tokens": {
      "$ref": "#/$defs/tokens"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "error_type": {
            "const": null
          },
          "refusal": {
            "const": null
          },
          "input_tokens": {
            "type": "integer"
          },
          "cached_input_tokens": {
            "type": "integer"
          },
          "cache_write_tokens": {
            "type": "integer"
          },
          "output_tokens": {
            "type": "integer"
          },
          "unpriced_cache_write_tokens": {
            "type": "integer"
          }
        }
      },
      "else": {
        "properties": {
          "error_type": {
            "type": "string"
          },
          "stop_reason": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error_type": {
            "const": "refused"
          }
        }
      },
      "then": {
        "properties": {
          "refusal": {
            "type": "object"
          },
          "http_status": {
            "const": null
          },
          "input_tokens": {
            "const": 0
          },
          "cached_input_tokens": {
            "const": 0
          },
          "cache_write_tokens": {
            "const": 0
          },
          "output_tokens": {
            "const": 0
          },
          "latency_ms": {
            "const": 0
          },
          "unpriced_cache_write_tokens": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "refusal": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "red"
          }
        }
      },
      "then": {
        "properties": {
          "log_seq_first": {
            "const": null
          },
          "log_seq_last": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "blue"
          }
        }
      },
      "then": {
        "properties": {
          "round": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": {
            "const": "analyst"
          }
        }
      },
      "then": {
        "properties": {
          "round": {
            "const": null
          },
          "log_seq_first": {
            "const": null
          },
          "log_seq_last": {
            "const": null
          }
        }
      }
    },
    {
      "comment": "unpriced writes are a part of the writes",
      "if": {
        "properties": {
          "unpriced_cache_write_tokens": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "unpriced_cache_write_tokens"
        ]
      },
      "then": {
        "properties": {
          "cache_write_tokens": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  ]
}
