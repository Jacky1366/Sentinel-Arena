{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-arena.local/schemas/anomaly.schema.json",
  "title": "Anomaly (contract 6.6)",
  "description": "One line of data/runs/<match_id>/anomalies.jsonl, written by the Judge. A harness self-check that tripped: never silently ignored, always shown in the terminal summary. The affected request is still scored where that is meaningful. A scripted stage check FAILs on any anomaly. rule_source_benign (Stage 5.3) is written by tools/score_rules.py into its own output directory: a rule whose source_request_id is a benign request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "match_id",
    "kind",
    "request_id",
    "detail"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "match_id": {
      "type": "string",
      "pattern": "^(m[0-9]{3,}|[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4})$"
    },
    "kind": {
      "enum": [
        "benign_solved_challenge",
        "benign_snapshot_missing",
        "unmatched_verdict",
        "rule_source_benign",
        "label_mismatch"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "detail": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "benign_solved_challenge"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "benign_id",
              "newly_solved",
              "expected_solves"
            ],
            "properties": {
              "benign_id": {
                "type": "string",
                "pattern": "^[nh][0-9]{2}$"
              },
              "newly_solved": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "expected_solves": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "benign_snapshot_missing"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "benign_id"
            ],
            "properties": {
              "benign_id": {
                "type": "string",
                "pattern": "^[nh][0-9]{2}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "unmatched_verdict"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "log_seq",
              "verdict"
            ],
            "properties": {
              "log_seq": {
                "type": "integer",
                "minimum": 1
              },
              "verdict": {
                "enum": [
                  "CWE-89",
                  "CWE-79",
                  "CWE-22",
                  "benign",
                  null
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "rule_source_benign"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "benign_id"
            ],
            "properties": {
              "rule_id": {
                "type": "string"
              },
              "benign_id": {
                "type": "string",
                "pattern": "^[nh][0-9]{2}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "label_mismatch"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "round",
              "label",
              "newly_solved",
              "conflicts"
            ],
            "properties": {
              "round": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "enum": [
                  "CWE-89",
                  "CWE-79",
                  "CWE-22"
                ]
              },
              "newly_solved": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "conflicts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "challenge",
                    "mapped_cwe"
                  ],
                  "properties": {
                    "challenge": {
                      "type": "string"
                    },
                    "mapped_cwe": {
                      "enum": [
                        "CWE-89",
                        "CWE-79",
                        "CWE-22"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
