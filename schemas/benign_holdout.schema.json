{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-arena.local/schemas/benign_holdout.schema.json",
  "title": "Offline benign line (contract 6.12, schema_version 0.1)",
  "description": "One line of benign/holdout_v1.jsonl (TEST, S6-1: offline scoring of library rules only) or benign/fixture_v2_offline.jsonl (TRAIN, D31: retention criterion (b) only): a benign request exactly as the proxy logged it when tools/build_holdout.py captured it outside any match (method/path/query/body verbatim). Sealed by sha256 in its .meta.json, committed before the first train match (D27). Never sent in a match; Blue never reads it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benign_id",
    "category",
    "look_alike",
    "method",
    "path",
    "query",
    "body"
  ],
  "properties": {
    "benign_id": {
      "type": "string",
      "pattern": "^(xn|xh|yh)[0-9]{2}$"
    },
    "category": {
      "enum": [
        "normal",
        "hard_negative"
      ]
    },
    "look_alike": {
      "enum": [
        "CWE-89",
        "CWE-79",
        "CWE-22",
        null
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "const": "normal"
          }
        }
      },
      "then": {
        "properties": {
          "benign_id": {
            "pattern": "^xn"
          },
          "look_alike": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "benign_id": {
            "pattern": "^(xh|yh)"
          },
          "look_alike": {
            "enum": [
              "CWE-89",
              "CWE-79",
              "CWE-22"
            ]
          }
        }
      }
    }
  ]
}
