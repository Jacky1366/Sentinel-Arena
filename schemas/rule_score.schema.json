{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-arena.local/schemas/rule_score.schema.json",
  "title": "Rule scoring manifest (contract 6.7)",
  "description": "rule_score.json, written LAST by tools/score_rules.py in its output directory: exactly what was scored, against what, by which logic. Blue must NEVER read it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "match_id",
    "match_json_sha256",
    "rules",
    "fixture",
    "judge_version",
    "normalization_version",
    "re2_version",
    "scored_at",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "match_id": {
      "type": "string",
      "pattern": "^(m[0-9]{3,}|[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4})$"
    },
    "match_json_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "sha256",
        "entries"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "judge_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1
    },
    "re2_version": {
      "type": "string",
      "minLength": 1
    },
    "scored_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "invalid",
        "replay_fires",
        "replay_misses",
        "replay_null",
        "rules_with_fixture_hits",
        "anomalies"
      ],
      "properties": {
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "replay_fires": {
          "type": "integer",
          "minimum": 0
        },
        "replay_misses": {
          "type": "integer",
          "minimum": 0
        },
        "replay_null": {
          "type": "integer",
          "minimum": 0
        },
        "rules_with_fixture_hits": {
          "type": "integer",
          "minimum": 0
        },
        "anomalies": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
