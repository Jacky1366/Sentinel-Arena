# Copy to .env and fill in. Never commit .env.
# ARENA_-prefixed on purpose: never use the SDKs' default names (OPENAI_API_KEY,
# ANTHROPIC_API_KEY, ...). If ANTHROPIC_API_KEY is exported in your shell, Claude
# Code itself bills that key. See docs/ops.md.
ARENA_OPENAI_API_KEY=
ARENA_ANTHROPIC_API_KEY=
ARENA_GEMINI_API_KEY=
